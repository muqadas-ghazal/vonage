# ── Required ─────────────────────────────────────────────────────────────────
# Project API key and project secret from the Vonage dashboard.
PROJECT_API_KEY=
PROJECT_SECRET=

# ── Required when deploying to Vercel or any serverless host ─────────────────
# Both browsers in a room must join the SAME Vonage session, so the room → session
# mapping has to be shared by every instance. Locally it lives in ./data/sessions.json;
# on serverless that fails twice over — the filesystem is read-only, and each instance
# would have its own copy, so two people in one room would land in different calls.
#
# Add a Vercel KV or Upstash Redis integration; both set these for you.
KV_REST_API_URL=
KV_REST_API_TOKEN=
